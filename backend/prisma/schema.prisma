generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  username    String?  @unique
  email       String   @unique
  password    String
  bio         String?
  avatar      String?
  avatarType  String?
  age         Int?
  showAge     Boolean  @default(false)
  pushToken   String?  // Expo push notification token
  createdAt   DateTime @default(now())

  movies            UserMovie[]
  sentInteractions  Interaction[] @relation("SentInteractions")
  recvInteractions  Interaction[] @relation("ReceivedInteractions")
  matchesAsUser1    Match[]       @relation("MatchUser1")
  matchesAsUser2    Match[]       @relation("MatchUser2")
  ratings           MovieRating[]
  sentMessages      Message[]
  watchlist         Watchlist[]
}

model Movie {
  id      String  @id @default(cuid())
  tmdbId  Int     @unique
  title   String
  poster  String?
  year    Int?

  users   UserMovie[]
  ratings MovieRating[]
}

model UserMovie {
  userId  String
  movieId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
}

model MovieRating {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
}

model Watchlist {
  id      String   @id @default(cuid())
  userId  String
  tmdbId  Int
  title   String
  poster  String?
  year    Int?
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
}

model Interaction {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  type       String
  createdAt  DateTime @default(now())

  fromUser User @relation("SentInteractions", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ReceivedInteractions", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([fromUserId, type])
}

model Match {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1    User      @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User      @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id        String    @id @default(cuid())
  matchId   String
  senderId  String
  text      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([senderId])
  @@index([matchId, createdAt])
}
